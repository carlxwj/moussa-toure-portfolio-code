# Public Firebase SDK configuration (not a secret). Use your own Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: Firebase Analytics ID; analytics loads only after the visitor accepts.
VITE_FIREBASE_MEASUREMENT_ID=
# Public reCAPTCHA Enterprise score-based website key (NOT the private API key).
# Authorize your production domains in App Check; never place a debug token in a public repository.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# For local localhost only: use a Firebase App Check debug token registered in the console.
# This variable has NO effect in production builds (guarded by import.meta.env.DEV).
VITE_FIREBASE_APPCHECK_DEBUG=false
# Formspree form ID (not email or URL). Unset means no public contact form.
VITE_FORMSPREE_FORM_ID=
VITE_PUBLIC_SITE_URL=http://localhost:5173

# URL of the private signature service (Cloudflare Worker; no API secrets here).
VITE_CLOUDINARY_GATEWAY_URL=
